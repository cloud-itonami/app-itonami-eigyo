{
  "name": "app-itonami-eigyo",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-01",
  "workers_dev": true,
  // E2EE stage-2 SFA (sealed records + did:key auth; see docs/sfa.md §11).
  // Plain JS, zero dependencies: wrangler deploys src/worker.js directly;
  // the build is just `node --check`.
  //
  // R2 NON-DEPENDENCE (owner policy 2026-11-23): this file intentionally has
  // NO r2 bucket binding and src/worker.js never touches R2. Content read
  // is GET https://yataverse.com/ipfs/<cid>, write is `yataverse put`
  // (not exposed as a route). D1/KV/DO/secrets are allowed by the policy
  // but are NOT created here — the EIGYO_DB binding below is a free-tier
  // placeholder (all-zero id; NOT created, mirrors schema.sql);
  // src/worker.js uses env.EIGYO_DB for sealed_records when the binding
  // is present and holds sealed envelopes in a marked DEMO fallback when
  // it is absent.
  // No paid resources.
  "d1_databases": [
    { "binding": "EIGYO_DB", "database_name": "app-itonami-eigyo", "database_id": "00000000-0000-0000-0000-000000000000" }
  ]
}
